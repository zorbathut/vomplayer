<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsBuildingOnLinux>$([MSBuild]::IsOSPlatform('Linux'))</IsBuildingOnLinux>
    <DefaultItemExcludes>$(DefaultItemExcludes);test/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.7.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
    <!-- Direct pin overriding Microsoft.Data.Sqlite's transitive SQLitePCLRaw 2.1.11, which has a known high-severity vulnerability (GHSA-2m69-gcr7-jv3q). Drop when Microsoft.Data.Sqlite bumps its own dependency. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Tomlyn" Version="2.3.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vomplayer.Tests" />
  </ItemGroup>

  <Target Name="BuildHdrHelper" Condition="'$(IsBuildingOnLinux)' == 'true'" BeforeTargets="Build" Inputs="$(MSBuildProjectDirectory)/src/Native/hdr_helper.c;$(MSBuildProjectDirectory)/src/Native/color-management-v1-protocol.c;$(MSBuildProjectDirectory)/src/Native/color-management-v1-client-protocol.h;$(MSBuildProjectDirectory)/src/Native/presentation-time-protocol.c;$(MSBuildProjectDirectory)/src/Native/presentation-time-client-protocol.h" Outputs="$(OutDir)libhdr_helper.so">
    <Exec Command="gcc -shared -fPIC -O2 -Wall -o $(OutDir)libhdr_helper.so $(MSBuildProjectDirectory)/src/Native/hdr_helper.c $(MSBuildProjectDirectory)/src/Native/color-management-v1-protocol.c $(MSBuildProjectDirectory)/src/Native/presentation-time-protocol.c -lwayland-client -lwayland-egl -lEGL" />
  </Target>

  <ItemGroup Condition="'$(IsBuildingOnLinux)' == 'true'">
    <!-- Link flattens the relative path so publish output puts libhdr_helper.so next to the apphost (where the P/Invoke loader looks) instead of nesting it under bin/Release/net10.0/linux-x64/ alongside it. -->
    <Content Include="$(OutDir)libhdr_helper.so" CopyToPublishDirectory="PreserveNewest" Link="libhdr_helper.so" />
  </ItemGroup>
</Project>
