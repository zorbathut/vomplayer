<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsBuildingOnLinux>$([MSBuild]::IsOSPlatform('Linux'))</IsBuildingOnLinux>
    <DefaultItemExcludes>$(DefaultItemExcludes);test/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vomplayer.Tests" />
  </ItemGroup>

  <Target Name="BuildHdrHelper" Condition="'$(IsBuildingOnLinux)' == 'true'" BeforeTargets="Build"
          Inputs="$(MSBuildProjectDirectory)/src/Native/hdr_helper.c;$(MSBuildProjectDirectory)/src/Native/color-management-v1-protocol.c;$(MSBuildProjectDirectory)/src/Native/color-management-v1-client-protocol.h;$(MSBuildProjectDirectory)/src/Native/presentation-time-protocol.c;$(MSBuildProjectDirectory)/src/Native/presentation-time-client-protocol.h"
          Outputs="$(OutDir)libhdr_helper.so">
    <Exec Command="gcc -shared -fPIC -O2 -Wall -o $(OutDir)libhdr_helper.so $(MSBuildProjectDirectory)/src/Native/hdr_helper.c $(MSBuildProjectDirectory)/src/Native/color-management-v1-protocol.c $(MSBuildProjectDirectory)/src/Native/presentation-time-protocol.c -lwayland-client -lwayland-egl -lEGL" />
  </Target>

  <ItemGroup Condition="'$(IsBuildingOnLinux)' == 'true'">
    <Content Include="$(OutDir)libhdr_helper.so" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
